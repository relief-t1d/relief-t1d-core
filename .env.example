# ==============================================================================
# DATA PATHS CONFIGURATION
# ==============================================================================

# Path to the source Parquet FILE with the CGM measurements (already filtered upstream).
# Used by generate_prediction_windows.py to generate windows and folds, and by
# train_prediction_models.py to generate them on-the-fly when they are missing.
PATH_TO_DATA="/path/to/your/local/data/source_measurements.parquet"


# Path to the DIRECTORY where the tagged k-fold datasets are stored (<base_output_dir>/folds/).
# Used by train_prediction_models.py to load (or save on-the-fly) the datasets.
# Must end with a path separator.
PATH_TO_DATA_WINDOWS="/path/to/your/local/datasets/folds/"
